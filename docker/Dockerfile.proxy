# Laravel Proxy Dockerfile
# PHP 8.5-FPM with extensions for Laravel + Bun for asset compilation

# Pin the multi-platform image (PHP 8.5.12, Alpine 3.24) for reproducible builds.
FROM serversideup/php:8.5.12-fpm-alpine@sha256:ef38dad515efd3b77288762f017feea5689239a46ca47de012a7adc4234875ff AS base

# Existing bind mounts and startup tasks require root. FPM workers retain the
# Alpine www-data UID/GID (82:82), configured by the ServerSideUp entrypoint.
USER root

# Keep the application's startup tasks and existing FPM concurrency. Compose
# defines service health checks; queue workers must not inherit an FPM check.
ENV AUTORUN_ENABLED=false \
    SHOW_WELCOME_MESSAGE=false \
    PHP_FPM_PM_MAX_CHILDREN=5
HEALTHCHECK NONE

# Install system dependencies
RUN apk add --no-cache \
    git \
    curl \
    zip \
    unzip \
    mariadb-client \
    supervisor \
    nodejs

# PDO drivers, mbstring, pcntl, Redis, zip, Composer and php-fpm-healthcheck
# are included in the base. PHP 8.5 includes OPcache in the runtime itself.
RUN install-php-extensions \
    exif \
    bcmath \
    gd \
    intl

# Keep the existing development/production php.ini and application overrides.
# ServerSideUp's full php.ini would otherwise override them from conf.d.
RUN rm "$PHP_INI_DIR/conf.d/serversideup-docker-php.ini"

# Install Bun (using official binary for Alpine/musl)
RUN apk add --no-cache bash \
    && curl -fsSL https://bun.sh/install | bash \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun
ENV PATH="/root/.bun/bin:${PATH}"

# Set working directory
WORKDIR /var/www/html

# Disable session upload progress before request parsing (CVE-2026-115560).
RUN echo "session.upload_progress.enabled=0" > "$PHP_INI_DIR/conf.d/session-security.ini"

# Copy entrypoint script
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# -------------------------------------------
# Development Stage
# -------------------------------------------
FROM base AS development

# Copy composer files first for better caching
COPY proxy/composer.json proxy/composer.lock ./

# Install development dependencies
RUN composer install --no-scripts --no-autoloader

# Copy application code
COPY proxy/ .

# Generate autoloader
RUN composer dump-autoload --optimize

# Copy Bun files and install dependencies
RUN bun install --frozen-lockfile

# PHP configuration for development
RUN mv "$PHP_INI_DIR/php.ini-development" "$PHP_INI_DIR/php.ini"

# Upload limits configuration
COPY docker/php-uploads.ini "$PHP_INI_DIR/conf.d/uploads.ini"

# Expose PHP-FPM port
EXPOSE 9000

ENTRYPOINT ["docker-php-serversideup-entrypoint", "/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]

# -------------------------------------------
# Production Stage
# -------------------------------------------
FROM base AS production

# Copy composer files first for better caching
COPY proxy/composer.json proxy/composer.lock ./

# Install production dependencies only
RUN composer install --no-dev --no-scripts --no-autoloader --optimize-autoloader

# Copy application code
COPY proxy/ .

# Generate optimized autoloader
RUN composer dump-autoload --optimize --classmap-authoritative

# Build assets with Bun (need devDependencies for vite)
RUN bun install --frozen-lockfile \
    && bun run build \
    && rm -rf node_modules

# PHP configuration for production
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"

# Upload limits configuration
COPY docker/php-uploads.ini "$PHP_INI_DIR/conf.d/uploads.ini"

# Configure OPcache for production
RUN echo "opcache.enable=1" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.memory_consumption=256" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.interned_strings_buffer=16" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.max_accelerated_files=20000" >> "$PHP_INI_DIR/conf.d/opcache.ini" \
    && echo "opcache.validate_timestamps=0" >> "$PHP_INI_DIR/conf.d/opcache.ini"

# Set proper permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

# Expose PHP-FPM port
EXPOSE 9000

ENTRYPOINT ["docker-php-serversideup-entrypoint", "/usr/local/bin/entrypoint.sh"]
CMD ["php-fpm"]
