# Laravel Proxy - Development Environment
APP_NAME="eScriptorium Proxy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database - MariaDB
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=proxy
DB_USERNAME=laravel
DB_PASSWORD=secret

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# eScriptorium Internal URL (Docker network)
ESCRIPTORIUM_URL=http://escriptorium-web:8000
ESCRIPTORIUM_WEBSOCKET_BASE_URL=http://escriptorium-nginx

# PostgreSQL (eScriptorium)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=escriptorium

# Domain
DOMAIN=localhost

# Vite Dev Server (for hot reload)
VITE_DEV_SERVER_URL=http://localhost:5173
