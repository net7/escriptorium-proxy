# Laravel Proxy - Staging Environment
APP_NAME="eScriptorium Proxy"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.yourdomain.com

# Database - MariaDB
DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=proxy
DB_USERNAME=laravel
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Session & Cache
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# eScriptorium Internal URL (Docker network)
ESCRIPTORIUM_URL=http://escriptorium-web:8000
ESCRIPTORIUM_WEBSOCKET_BASE_URL=http://escriptorium-nginx

# PostgreSQL (eScriptorium)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=escriptorium
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=escriptorium

# Domain
DOMAIN=staging.yourdomain.com

# Flower Authentication
FLOWER_BASIC_AUTH=flower:CHANGE_ME_PASSWORD
